# ParcelPilot local Docker configuration.
# Copy this file to .env and adjust values only when needed.

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

POSTGRES_USER=parcelpilot
POSTGRES_PASSWORD=parcelpilot_secret
POSTGRES_DB=parcelpilot_db
POSTGRES_PORT=5432
FRONTEND_PORT=3000
API_PORT=8000

SECRET_KEY=parcelpilot_dev_secret_key_change_me_in_production_123456789
# Include 3001 for local port-conflict overrides during review/demo.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Primary Verified LLM Provider (OpenRouter / OpenAI)
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ParcelPilot

# Optional OpenAI Provider
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional Ollama Provider (Best-effort for function-calling models)
OLLAMA_BASE_URL=http://host.docker.internal:11434

BOOTSTRAP_DATA=true

# Local Hugging Face embedding model used by sentence-transformers.
# Qwen3-Embedding-0.6B outputs 1024 dimensions, matching the pgvector column.
# Use EMBEDDING_PROVIDER=hash for lightweight/fast deterministic testing.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

