# ParcelPilot local Docker configuration.
# Copy this file to .env and adjust values only when needed.

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

POSTGRES_USER=parcelpilot
POSTGRES_PASSWORD=parcelpilot_secret
POSTGRES_DB=parcelpilot_db
POSTGRES_PORT=5432
FRONTEND_PORT=3000

SECRET_KEY=parcelpilot_dev_secret_key_change_me_in_production_123456789
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=

BOOTSTRAP_DATA=true

# Local Hugging Face embedding model used by sentence-transformers.
# all-MiniLM-L6-v2 outputs 384 dimensions, matching the pgvector column.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
