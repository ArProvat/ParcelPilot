# Application Settings
PROJECT_NAME="ParcelPilot"
API_V1_STR="/api/v1"
APP_ENV=development
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
BOOTSTRAP_DATA=true
DATA_DIR=../data

# PostgreSQL Database Configuration
POSTGRES_USER=parcelpilot
POSTGRES_PASSWORD=parcelpilot_secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=parcelpilot_db
DATABASE_URL=postgresql+asyncpg://parcelpilot:parcelpilot_secret@localhost:5432/parcelpilot_db

# Security & JWT Auth
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32bytesmin
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & AI Agents (LangChain / LangGraph)
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
